#!/bin/sh
# Focus Lock pre-push hook: run the same checks as the weekly release gate
# (.github/workflows/release.yml) so a push doesn't break the next release.
# It no longer builds or deploys: the installed app updates itself from GitHub
# Releases, and a dev copy in %APPDATA% clashed with it. Run
# scripts/deploy.ps1 by hand when you want a local dev build.
#
# Enable once with:  git config core.hooksPath scripts/hooks
# Skip for one push:  git push --no-verify

repo="$(git rev-parse --show-toplevel)" || exit 0
cd "$repo" || exit 0

fail() {
	echo "pre-push: $1 failed; push aborted. Use 'git push --no-verify' to push anyway." 1>&2
	exit 1
}

# main.go embeds frontend/dist, which go vet/test need to exist.
if [ ! -d frontend/dist ]; then
	(cd frontend && npm run build) || fail "frontend build"
fi
go vet ./... || fail "go vet"
go test ./... || fail "go test"
(cd frontend && npx tsc --noEmit) || fail "frontend typecheck"
exit 0
